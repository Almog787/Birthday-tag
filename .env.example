# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YouTube Data API v3 OAuth Credentials (stored in GitHub Repository Secrets)
YOUTUBE_CLIENT_ID="your_google_cloud_client_id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your_google_cloud_client_secret"
YOUTUBE_REFRESH_TOKEN="your_oauth_refresh_token"
YOUTUBE_PRIVACY_STATUS="unlisted" # unlisted, public, or private

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
